/dts-v1/;

/ {
    model = "Chassis Controller STM32G474VET6";
    compatible = "shanjiancaofu,chassis-g474";

    chosen {
        chassis,can = <&can0>;
        chassis,imu = <&imu0>;
        chassis,display = <&display0>;
        chassis,flash = <&flash0>;
        chassis,drive = <&drive0>;
        chassis,uart = <&uart0>;
        chassis,watchdog = <&watchdog0>;
        chassis,rtc = <&rtc0>;
        chassis,time = <&time0>;
        chassis,left-encoder = <&left_encoder>;
        chassis,right-encoder = <&right_encoder>;
        chassis,power = <&power0>;
        chassis,buttons = <&buttons0>;
        chassis,leds = <&leds0>;
        chassis,sr501 = <&sr5010>;
        chassis,estop = <&estop0>;
    };

    aliases {
        can = &can0;
        imu = &imu0;
        display = &display0;
        flash = &flash0;
        drive = &drive0;
        left-encoder = &left_encoder;
        right-encoder = &right_encoder;
    };

    gpioa: gpio-a { chassis,device-id = "gpioa"; compatible = "st,stm32-gpio-port"; status = "okay"; gpio-controller; #gpio-cells = <2>; };
    gpiob: gpio-b { chassis,device-id = "gpiob"; compatible = "st,stm32-gpio-port"; status = "okay"; gpio-controller; #gpio-cells = <2>; };
    gpioc: gpio-c { chassis,device-id = "gpioc"; compatible = "st,stm32-gpio-port"; status = "okay"; gpio-controller; #gpio-cells = <2>; };
    gpiod: gpio-d { chassis,device-id = "gpiod"; compatible = "st,stm32-gpio-port"; status = "okay"; gpio-controller; #gpio-cells = <2>; };

    buttons0: buttons { chassis,device-id = "buttons0"; compatible = "chassis,buttons"; status = "okay"; gpios = <&gpiod 3 1 &gpiod 4 1 &gpiob 8 0>; };
    leds0: leds { chassis,device-id = "leds0"; compatible = "chassis,leds"; status = "okay"; gpios = <&gpioc 0 1 &gpioc 1 1 &gpioc 2 1>; };
    estop0: emergency-stop { chassis,device-id = "estop0"; compatible = "chassis,emergency-stop"; status = "okay"; gpios = <&gpiod 2 1>; };
    sr5010: motion-sensor { chassis,device-id = "sr5010"; compatible = "chassis,sr501"; status = "okay"; gpios = <&gpiod 5 0>; };

    can0: fdcan2 {
        chassis,device-id = "can0";
        compatible = "st,stm32g4-fdcan";
        status = "okay";
        bitrate = <500000>;
        sample-point = <800>;
        bitrate-data = <2000000>;
        sample-point-data = <824>;
        standard-filter-count = <2>;
    };

    spi3 {
        #address-cells = <1>;
        #size-cells = <0>;

        imu0: sensor@0 {
            chassis,device-id = "imu0";
            compatible = "invensense,icm45686";
            status = "okay";
            reg = <0>;
            frequency = <1328125>;
        };
    };

    spi2 {
        #address-cells = <1>;
        #size-cells = <0>;

        display0: display@0 {
            chassis,device-id = "display0";
            compatible = "sitronix,st7789v";
            status = "okay";
            reg = <0>;
            width = <320>;
            height = <240>;
        };
    };

    quadspi1 {
        #address-cells = <1>;
        #size-cells = <0>;

        flash0: flash@0 {
            chassis,device-id = "flash0";
            compatible = "winbond,w25q64";
            status = "okay";
            reg = <0>;
            size = <0x00800000>;
            erase-block-size = <4096>;
            write-block-size = <256>;
        };
    };

    drive0: tim8-motor-controller {
        chassis,device-id = "drive0";
        compatible = "st,stm32-pwm-drive";
        status = "okay";
        pwm-period = <8499>;
    };

    uart0: usart1 {
        chassis,device-id = "uart0";
        compatible = "st,stm32-uart";
        status = "okay";
    };

    watchdog0: watchdog {
        chassis,device-id = "watchdog0";
        compatible = "st,stm32-iwdg";
        status = "okay";
    };

    rtc0: rtc {
        chassis,device-id = "rtc0";
        compatible = "st,stm32-rtc";
        status = "okay";
    };

    time0: system-time {
        chassis,device-id = "time0";
        compatible = "chassis,system-time";
        status = "okay";
    };

    left_encoder: tim2-encoder {
        chassis,device-id = "left_encoder";
        compatible = "st,stm32-tim-encoder";
        status = "okay";
    };

    right_encoder: tim4-encoder {
        chassis,device-id = "right_encoder";
        compatible = "st,stm32-tim-encoder";
        status = "okay";
    };

    adc1 {
        #address-cells = <1>;
        #size-cells = <0>;

        power0: power-monitor@3 {
            chassis,device-id = "power0";
            compatible = "st,stm32-adc-power";
            status = "okay";
            reg = <3>;
        };
    };
};
